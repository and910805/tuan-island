extends "res://tests/test_jinguashi_journey.gd"

const HOME_CHEST := Vector2i(40,38)
const HOME_BOARD := Vector2i(40,29)
const DELIVERY_TIME := 60.0

func after_chapter()->void:
	super.after_chapter()
	if failed:return
	var mine=World.MINES
	var bench:=GARDEN_JOURNEY_BENCH
	var mill:=Vector2i(40,36)
	var kiln:=Vector2i(41,37)
	gather("wood","tree","axe",48,3)
	gather("stone","rock","pick",20,2)
	act("craft",bench,"kiln_kit")
	if world.resource(kiln)=="grass":act("axe",kiln)
	act("build",kiln,"charcoal_kiln")
	for batch in range(5):mill_batch(mill)
	act("start_processing",kiln,"charcoal")
	expect(world.step(World.INDUSTRY.PROCESS.charcoal.time,true),"Charcoal batch matures")
	act("claim_processing",kiln)
	for count in range(4):act("craft",bench,"copper_joint")
	for kit in ["pump_kit","pipe_kit","tank_kit"]:act("craft",bench,kit)
	gather("wood","tree","axe",27,3)
	if world.resource(HOME_CHEST)=="grass":act("axe",HOME_CHEST)
	act("build",HOME_CHEST,"private_chest")
	checkpoint("mine-prepared")
	act("transit",World.REGIONS.exit_cell("home"),"jinguashi")
	act("mine_travel",mine.ENTRY,"mine_1")
	expect(world.player_region(TOKEN)=="mine_1","Surface entrance opens real underground map")
	checkpoint("floor1")
	act("pick",mine.NODES[0])
	act("mine_rest",mine.REST)
	expect(int(person().mine_energy)==100,"Rest replenishes mining energy without taking items")
	act("mine_commission",mine.SERVICE)
	act("mine_travel",mine.DOWN,"mine_2")
	checkpoint("floor2")
	for node:Vector2i in [mine.NODES[0],mine.NODES[1]]:act("pick",node)
	act("mine_commission",mine.SERVICE)
	act("mine_travel",mine.DOWN,"mine_3")
	checkpoint("floor3-dry")
	act("build",Vector2i(29,23),"water_pump")
	act("build",Vector2i(30,23),"water_pipe")
	act("build",Vector2i(31,23),"water_tank")
	act("toggle_pump",Vector2i(29,23))
	checkpoint("pump-running")
	for tick in range(3):expect(world.step(World.INDUSTRY.INTERVAL,true),"Actual existing pump advances drainage")
	expect(int(world.state.mine_depths.pumped)==24,"Physical pump network drained required water")
	checkpoint("drain-ready")
	act("mine_commission",mine.SERVICE)
	act("mine_travel",mine.DOWN,"mine_4")
	checkpoint("floor4")
	act("pick",mine.NODES[0])
	act("mine_commission",mine.SERVICE)
	var copper_before := int(bag().get("copper_ore",0))
	act("freight_load",mine.SERVICE,"copper_ore:2")
	expect(int(bag().get("copper_ore",0))==copper_before-2,"Loading debits copper on floor four")
	act("mine_travel",mine.DOWN,"mine_5")
	checkpoint("floor5")
	for node:Vector2i in [mine.NODES[0],mine.NODES[1]]:act("pick",node)
	expect(int(bag().get("gold_ore",0))==4,"Deepest work face yields deterministic gold-bearing ore")
	# Exhaust via legal mining actions and normal world-time cooldowns, never fixture stamina edits.
	if failed:return
	var mined_before:int=bag().gold_ore
	var energy:int=person().mine_energy
	for count in range(energy/10):
		expect(world.step(mine.COOLDOWN,true),"Cooldown progresses with a connected island resident")
		act("pick",mine.NODES[0])
	expect(Vector2(person().x,person().y).distance_to(Vector2(mine.REST)+Vector2(0.5,0.5))<3.2,"Exhaustion returns to underground rest point")
	expect(int(bag().reinforced_pick)==1 and int(bag().gold_ore)==mined_before+(energy/10)*2,"Exhaustion keeps tools and every awarded ore")
	checkpoint("mine-rested")
	act("mine_rest",mine.REST)
	act("freight_load",mine.SERVICE,"gold_ore:3")
	act("freight_target",mine.SERVICE,World.key(HOME_CHEST))
	var payload := {"copper_ore":2,"gold_ore":3}
	expect(freight_job().get("items")==payload,"Draft holds the exact naturally mined cargo")
	checkpoint("freight-draft")
	act("freight_dispatch",mine.SERVICE)
	var post_dispatch_bag := bag().duplicate(true)
	expect(freight_job().get("status")=="transit" and freight_job().get("ready")==float(world.state.time)+DELIVERY_TIME,"Dispatch schedules one shipment at the world clock deadline")
	checkpoint("freight-transit")
	expect(world.step(DELIVERY_TIME-1.0,true),"Advance 59 world seconds in the mine")
	expect(freight_job().get("status")=="transit" and int(chest_items().get("gold_ore",0))==0,"No early delivery to the home chest")
	expect(world.step(1.0,true),"Advance the last world second in the mine")
	expect(world.player_region(TOKEN)=="mine_5" and freight_job().get("status")=="delivered" and chest_items()==payload and bag()==post_dispatch_bag,"Cargo arrives only in the home chest while the resident stays underground")
	checkpoint("freight-delivered")
	var delivered := World.new()
	expect(delivered.load_world(world.save_path) and delivered.player_region(TOKEN)=="mine_5" and not delivered.recovered_from_backup and int(delivered.state.objects[World.key(HOME_CHEST)].items.get("copper_ore",0))==2 and int(delivered.state.objects[World.key(HOME_CHEST)].items.get("gold_ore",0))==3,"Remote chest delivery survives save and reload")
	walk_home(5)
	for item in payload:
		for unit in range(payload[item]):act("withdraw",HOME_CHEST,item)
		expect(int(chest_items().get(item,0))==0 and int(bag().get(item,0))==int(post_dispatch_bag.get(item,0))+int(payload[item]),"Withdraw every delivered unit of " + item)
	var joints_before := int(bag().get("copper_joint",0))
	act("craft",bench,"copper_joint")
	act("craft",bench,"gold_sample")
	expect(int(bag().get("copper_joint",0))==joints_before+1 and int(bag().get("gold_sample",0))==1,"The original home workbench accepts the returned shipment materials")
	checkpoint("freight-crafted")

	act("transit",World.REGIONS.exit_cell("home"),"jinguashi")
	act("mine_travel",mine.ENTRY,"mine_1")
	for level in range(2,5):act("mine_travel",mine.DOWN,"mine_%d"%level)
	act("pick",mine.NODES[0])
	var fallback_payload := {"copper_ore":6}
	act("freight_load",mine.SERVICE,"copper_ore:6")
	act("freight_target",mine.SERVICE,World.key(HOME_CHEST))
	act("freight_dispatch",mine.SERVICE)
	walk_home(4)
	act("remove",HOME_CHEST)
	act("build",HOME_CHEST,"private_chest")
	var before_claim := bag().duplicate(true)
	expect(world.step(DELIVERY_TIME,true),"Advance 60 world seconds with the addressed chest replaced")
	expect(freight_job().get("status")=="held" and freight_job().get("items")==fallback_payload and chest_items().is_empty() and bag()==before_claim,"Reusing a cell with a new chest leaves the original shipment held")
	checkpoint("freight-held")
	var held := World.new()
	expect(held.load_world(world.save_path) and not held.recovered_from_backup,"Held shipment reloads from the primary save")
	if failed:return
	var held_receipt: Dictionary = held.state.mine_freight.jobs.get(TOKEN,{})
	var held_items: Dictionary = held_receipt.get("items",{})
	expect(held_receipt.get("status")=="held" and held_items.size()==1 and int(held_items.get("copper_ore",0))==6,"Held cargo survives reload until the owner claims it")
	world=held
	act("freight_claim",HOME_BOARD)
	expect(int(bag().get("copper_ore",0))==int(before_claim.get("copper_ore",0))+6 and freight_job().get("status")=="delivered" and chest_items().is_empty(),"Owner recovers every held unit at the original home notice board")
	checkpoint("freight-claimed")
	var reopened := World.new()
	expect(reopened.load_world(world.save_path) and reopened.state.mine_depths.unlocked==5 and reopened.state.mine_depths.pumped==24 and reopened.state.players[TOKEN].inventory==bag(),"Both freight loops and all five layers survive reload")
	print("FREIGHT_NATURAL_LOOP actions=%d walking=%d no_fixture_grants=true accelerated_freight_seconds=%.1f accelerated_world_seconds=%.1f"%[actions,walking,2.0*DELIVERY_TIME,world.state.time])

func freight_job() -> Dictionary:
	return world.state.mine_freight.jobs.get(TOKEN,{})

func chest_items() -> Dictionary:
	return world.state.objects.get(World.key(HOME_CHEST),{}).get("items",{})

func walk_home(depth: int) -> void:
	for level in range(depth,1,-1):act("mine_travel",World.MINES.UP,"mine_%d"%(level-1))
	act("mine_travel",World.MINES.UP,"jinguashi")
	act("transit",World.REGIONS.exit_cell("jinguashi"),"home")
