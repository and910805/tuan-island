extends SceneTree
const Checker=preload("res://scripts/version_update_checker.gd")
func _initialize()->void:
	var path:=OS.get_environment("TUAN_SIGNED_RELEASE_FIXTURE")
	assert(not path.is_empty())
	var key:=Checker.installed_public_key()
	assert(key!=null and key.is_public_only())
	var wire:=FileAccess.get_file_as_bytes(path)
	var release:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://release.json"))
	var expected:=OS.get_environment("TUAN_EXPECTED_RELEASE_VERSION")
	if expected.is_empty():expected=Checker.packaged_version(str(release.version),release.build)
	var info:=Checker.verify_manifest(wire,key,"0.50.20-dev")
	assert(info.get("latest_version","")==expected and info.get("required",false))
	assert(info.get("binary_hashes",{}).size()==2)
	assert(Checker.verify_manifest(wire,key,expected).is_empty())
	print("PINNED_RELEASE_MANIFEST_PASS production public key verifies signed release "+expected+", current version ignored")
	quit(0)
