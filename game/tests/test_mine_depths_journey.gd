extends "res://tests/test_jinguashi_journey.gd"

func after_chapter()->void:
	super.after_chapter()
	if failed:return
	var mine=World.MINES
	var bench:=GARDEN_JOURNEY_BENCH
	var mill:=Vector2i(40,36)
	var kiln:=Vector2i(41,37)
	gather("wood","tree","axe",48,3)
	gather("stone","rock","pick",20,2)
	act("craft",bench,"kiln_kit")
	if world.resource(kiln)=="grass":act("axe",kiln)
	act("build",kiln,"charcoal_kiln")
	for batch in range(5):mill_batch(mill)
	act("start_processing",kiln,"charcoal")
	expect(world.step(World.INDUSTRY.PROCESS.charcoal.time,true),"Charcoal batch matures")
	act("claim_processing",kiln)
	for count in range(4):act("craft",bench,"copper_joint")
	for kit in ["pump_kit","pipe_kit","tank_kit"]:act("craft",bench,kit)
	checkpoint("mine-prepared")
	act("transit",World.REGIONS.exit_cell("home"),"jinguashi")
	act("mine_travel",mine.ENTRY,"mine_1")
	expect(world.player_region(TOKEN)=="mine_1","Surface entrance opens real underground map")
	checkpoint("floor1")
	act("pick",mine.NODES[0])
	act("mine_rest",mine.REST)
	expect(int(person().mine_energy)==100,"Rest replenishes mining energy without taking items")
	act("mine_commission",mine.SERVICE)
	act("mine_travel",mine.DOWN,"mine_2")
	checkpoint("floor2")
	for node:Vector2i in [mine.NODES[0],mine.NODES[1]]:act("pick",node)
	act("mine_commission",mine.SERVICE)
	act("mine_travel",mine.DOWN,"mine_3")
	checkpoint("floor3-dry")
	act("build",Vector2i(29,23),"water_pump")
	act("build",Vector2i(30,23),"water_pipe")
	act("build",Vector2i(31,23),"water_tank")
	act("toggle_pump",Vector2i(29,23))
	checkpoint("pump-running")
	for tick in range(3):expect(world.step(World.INDUSTRY.INTERVAL,true),"Actual existing pump advances drainage")
	expect(int(world.state.mine_depths.pumped)==24,"Physical pump network drained required water")
	checkpoint("drain-ready")
	act("mine_commission",mine.SERVICE)
	act("mine_travel",mine.DOWN,"mine_4")
	checkpoint("floor4")
	act("pick",mine.NODES[0])
	act("mine_commission",mine.SERVICE)
	act("mine_travel",mine.DOWN,"mine_5")
	checkpoint("floor5")
	for node:Vector2i in [mine.NODES[0],mine.NODES[1]]:act("pick",node)
	expect(int(bag().get("gold_ore",0))==4,"Deepest work face yields deterministic gold-bearing ore")
	# Exhaust via legal mining actions and normal world-time cooldowns, never fixture stamina edits.
	var mined_before:int=bag().gold_ore
	var energy:int=person().mine_energy
	for count in range(energy/10):
		expect(world.step(mine.COOLDOWN,true),"Cooldown progresses with a connected island resident")
		act("pick",mine.NODES[0])
	expect(Vector2(person().x,person().y).distance_to(Vector2(mine.REST)+Vector2(0.5,0.5))<3.2,"Exhaustion returns to underground rest point")
	expect(int(bag().reinforced_pick)==1 and int(bag().gold_ore)==mined_before+(energy/10)*2,"Exhaustion keeps tools and every awarded ore")
	checkpoint("mine-rested")
	act("mine_rest",mine.REST)
	for level in range(5,1,-1):act("mine_travel",mine.UP,"mine_%d"%(level-1))
	act("mine_travel",mine.UP,"jinguashi")
	act("transit",World.REGIONS.exit_cell("jinguashi"),"home")
	act("craft",bench,"gold_sample")
	expect(int(bag().get("gold_sample",0))==1,"Gold-bearing material becomes original collection sample at workbench")
	checkpoint("gold-home")
	var reopened:=World.new()
	expect(reopened.load_world(world.save_path) and reopened.state.mine_depths.unlocked==5 and reopened.state.mine_depths.pumped==24 and reopened.state.players[TOKEN].inventory==bag(),"All five layers, engineered drainage and collection survive reload")
	print("DEPTHS_NATURAL_LOOP actions=%d walking=%d no_fixture_grants=true accelerated_world_seconds=%.1f"%[actions,walking,world.state.time])
