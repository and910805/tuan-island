extends "res://tests/test_chapter_journey.gd"

func after_chapter()->void:
	if failed:return
	for tile in [Vector2i(43,34),Vector2i(44,34),Vector2i(44,35),Vector2i(44,36)]:act("remove",tile)
	act("travel",World.REGIONS.exit_cell("home"),"lanyang")
	expect(world.player_region(TOKEN)=="lanyang","Natural journey reaches the trial field")
	var plot:=Vector2i(14,22)
	act("hoe",plot)
	act("seed",plot,"radish")
	act("build",Vector2i(15,22),"sprinkler")
	act("build",Vector2i(16,22),"water_pipe")
	act("build",Vector2i(16,23),"water_pipe")
	act("build",Vector2i(16,24),"water_tank")
	act("refill_tank",Vector2i(16,24))
	act("toggle_sprinkler",Vector2i(15,22))
	expect(world.step(8.0,true) and world.state.regions.lanyang.crops["14,22"].wet,"Reused equipment irrigates Lanyang crop")
	checkpoint("lanyang")
	act("travel",World.REGIONS.exit_cell("lanyang"),"home")
	expect(world.step(World.CROPS.radish.time,true),"Farm continues while player is home")
	act("travel",World.REGIONS.exit_cell("home"),"lanyang")
	var before:=int(bag().get("radish",0))
	act("harvest",plot)
	expect(int(bag().radish)==before+1,"Outer harvest enters same inventory")
	act("travel",World.REGIONS.exit_cell("lanyang"),"home")
	var coins:=int(person().coins)
	act("ship",World.SHIPPING.cell_for(world.state),JSON.stringify([[["radish",1]],24]))
	expect(int(person().coins)==coins+24,"Travel farming returns real shipping income")
	checkpoint("returned")
	var reload:=World.new()
	expect(reload.load_world(world.save_path) and reload.player_region(TOKEN)=="home" and reload.state.regions.lanyang.objects.size()==4 and reload.state.players[TOKEN].coins==person().coins,"Home return, field machinery and proceeds all persist")
	print("REGIONS_NATURAL_LOOP actions=%d walking=%d no_fixture_grants=true"%[actions,walking])
